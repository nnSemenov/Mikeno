FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeFunc multiValveEngineState
#includeFunc bXiProgress
#includeFunc cellMin(b)
#includeFunc isoSurface
(
    name=kernel,
    writeControl=adjustableRunTime,
    writeIntervals=
    (
        (-180 none)
        (-15 1)
        (5 5)
        (30 once)
    ),
    isoField=b,
    isoValue=0.5,
    fields=(Xi)
)

